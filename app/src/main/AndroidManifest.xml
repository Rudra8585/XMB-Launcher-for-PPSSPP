<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed on Android 11+ to see whether PPSSPP is installed. -->
    <queries>
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.ppsspp.ppssppgold" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Other home apps, for Settings › Open Home App. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Game › Android Apps lists every app on the device, not only the ones Android shows by default. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Keeps the screen black over PPSSPP while it loads a game (only once the user allows it). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Xmb">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:showWhenLocked="true">
            <!-- showWhenLocked here, not only in code, so even the black starting window covers the
                 lock screen at power-on. Not directBootAware: at power-on Android would then see a
                 different set of home apps before the unlock and drop the user's default home choice. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Lets Android offer this as the home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Black screen over the status bar at power-on (see BootCover). Runs before the unlock; it is
             not a home screen, so it doesn't affect Android's choice of home app. -->
        <service
            android:name=".BootCover"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/boot_cover_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/boot_cover" />
        </service>
        <!-- Restarts the app after the look changes; runs in its own process so it can end the main one. -->
        <activity
            android:name=".Restarter"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:process=":restart"
            android:theme="@style/Theme.Xmb" />
    </application>
</manifest>
